# Copy this file to .env and fill in your own values.

PORT=4000
MONGO_URI=mongodb://localhost:27017/dental_management
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Optional: create an admin account on first start (seed/featuredDoctors.js)
SEED_ADMIN_EMAIL=admin@smilecare.com
SEED_ADMIN_PASSWORD=
# Optional: default password for seeded doctor accounts
SEED_DOCTOR_PASSWORD=

# Optional: SMTP settings for sending emails (utils/mailer.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
